<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Inicio de sesión - SIGCAT
    Una sola tarjeta centrada de tamaño fijo (no se estira al maximizar la ventana).
    Izquierda: presentación para el ciudadano. Derecha: formulario.
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sigcat.controllers.LoginController"
            prefHeight="640.0" prefWidth="960.0"
            styleClass="auth-root">
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="auth-scroll">
            <VBox alignment="CENTER" spacing="16.0">
                <padding>
                    <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                </padding>

                <HBox styleClass="auth-shell" maxWidth="-Infinity" maxHeight="-Infinity">

                    <!-- ─── PANEL DE PRESENTACIÓN ─── -->
                    <VBox prefWidth="400.0" spacing="16.0" styleClass="auth-hero-panel">
                        <padding>
                            <Insets top="40.0" right="40.0" bottom="32.0" left="40.0"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <StackPane styleClass="brand-mark">
                                <Label text="S" styleClass="brand-mark-text"/>
                            </StackPane>
                            <VBox spacing="1.0">
                                <Label text="SIGCAT" styleClass="brand-name"/>
                                <Label text="Alcaldía de Sincelejo" styleClass="brand-caption"/>
                            </VBox>
                        </HBox>

                        <Region prefHeight="12.0"/>

                        <Label styleClass="hero-badge" text="CATASTRO MULTIPROPÓSITO · SUCRE"/>
                        <Label styleClass="hero-title" text="Su predio, registrado y verificado" wrapText="true"/>
                        <Label styleClass="hero-description" wrapText="true"
                               text="Radique sus predios, siga el estado de sus solicitudes y obtenga su certificado catastral desde un solo lugar."/>

                        <VBox spacing="10.0">
                            <padding>
                                <Insets top="6.0"/>
                            </padding>
                            <Label styleClass="hero-feature" wrapText="true" text="✔  Dibuje los linderos de su predio sobre el mapa de Sincelejo"/>
                            <Label styleClass="hero-feature" wrapText="true" text="✔  Verificación automática de que no invade predios vecinos"/>
                            <Label styleClass="hero-feature" wrapText="true" text="✔  Certificado catastral con código QR verificable"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>
                        <Label styleClass="hero-footnote" text="Código DANE 70001 · Sincelejo, Sucre"/>
                    </VBox>

                    <!-- ─── FORMULARIO ─── -->
                    <VBox prefWidth="440.0" spacing="16.0" alignment="CENTER_LEFT" styleClass="auth-form-panel">
                        <padding>
                            <Insets top="44.0" right="44.0" bottom="40.0" left="44.0"/>
                        </padding>

                        <VBox spacing="4.0">
                            <Label styleClass="auth-title" text="Iniciar sesión"/>
                            <Label styleClass="auth-subtitle" text="Ingrese con su número de documento y contraseña."/>
                        </VBox>

                        <Label fx:id="lblMensajeExito" styleClass="feedback-success-label" wrapText="true"
                               maxWidth="1.7976931348623157E308" visible="false" managed="false"/>

                        <VBox spacing="6.0">
                            <Label styleClass="field-label" text="Número de documento"/>
                            <TextField fx:id="txtDocumento" promptText="Ej: 1102854321" styleClass="text-input"/>
                        </VBox>

                        <VBox spacing="6.0">
                            <Label styleClass="field-label" text="Contraseña"/>
                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                <StackPane HBox.hgrow="ALWAYS">
                                    <PasswordField fx:id="txtPassword" maxWidth="1.7976931348623157E308" promptText="Ingrese su contraseña"
                                                   styleClass="text-input"/>
                                </StackPane>
                                <Button fx:id="btnVerPassword" text="Mostrar" minWidth="-Infinity"
                                        styleClass="btn-toggle-password"/>
                            </HBox>
                            <Label fx:id="lblBloqMayus" text="⚠ Bloq Mayús está activado" styleClass="caps-warning"
                                   visible="false" managed="false"/>
                        </VBox>

                        <!-- Solo ocupa espacio cuando hay un mensaje (ver LoginController.initialize) -->
                        <Label fx:id="lblErrorLogin" styleClass="feedback-label" wrapText="true"
                               maxWidth="1.7976931348623157E308"/>

                        <Button fx:id="btnIngresar" defaultButton="true" maxWidth="1.7976931348623157E308"
                                mnemonicParsing="false" onAction="#iniciarSesion" styleClass="btn-primary-lg"
                                text="Ingresar"/>

                        <Separator/>

                        <HBox alignment="CENTER" spacing="6.0">
                            <Label styleClass="auth-subtitle" text="¿No tiene cuenta de propietario?"/>
                            <Hyperlink onAction="#irARegistro" styleClass="auth-link" text="Regístrese aquí"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Label styleClass="auth-footer" text="SIGCAT · Sistema de Información Geográfica y Catastral · Alcaldía de Sincelejo"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
