<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Vista de Bandeja de Auditoría del Funcionario - SIGCAT Hito 2
    Controlador: com.sigcat.controllers.MenuFuncionarioController
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sigcat.controllers.MenuFuncionarioController"
            styleClass="menu-root"
            prefWidth="1200.0" prefHeight="750.0">

    <!-- CABECERA DEL FUNCIONARIO -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-navbar">
            <padding>
                <Insets bottom="14.0" left="24.0" right="24.0" top="14.0"/>
            </padding>
            <VBox spacing="2.0">
                <Label styleClass="navbar-title" text="SIGCAT — Consola de Auditoría y Dictamen Catastral"/>
                <Label styleClass="navbar-subtitle" text="Dirección de Catastro Multipropósito — Municipio de Sincelejo, Sucre"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button mnemonicParsing="false" onAction="#inspeccionarEnMapa" styleClass="btn-secondary" text="🗺️ Inspeccionar en Mapa"/>
            <Button mnemonicParsing="false" onAction="#cargarSolicitudesPorFiltro" styleClass="btn-secondary" text="🔄 Actualizar Bandeja"/>
            <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="btn-outline" text="🚪 Cerrar Sesión"/>
        </HBox>
    </top>

    <!-- CUERPO CENTRAL: KPI CARDS + TABLA DE SOLICITUDES -->
    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets bottom="16.0" left="24.0" right="24.0" top="16.0"/>
            </padding>

            <!-- TARJETAS KPI Y FILTRO -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <VBox styleClass="kpi-card-warning" prefWidth="240.0">
                    <Label styleClass="kpi-title" text="SOLICITUDES PENDIENTES"/>
                    <Label fx:id="lblResumenPendientes" styleClass="kpi-number" text="0"/>
                </VBox>

                <VBox styleClass="kpi-card-success" prefWidth="240.0">
                    <Label styleClass="kpi-title" text="PREDIOS APROBADOS"/>
                    <Label fx:id="lblResumenAprobados" styleClass="kpi-number" text="0"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="6.0">
                    <Label styleClass="field-label" text="Filtrar Bandeja por Estado:"/>
                    <ComboBox fx:id="cmbFiltroEstado" prefWidth="220.0" styleClass="combo-input"/>
                </VBox>
            </HBox>

            <!-- TABLA DE SOLICITUDES CATASTRALES -->
            <TableView fx:id="tablaSolicitudes" VBox.vgrow="ALWAYS" styleClass="modern-table">
                <columns>
                    <TableColumn fx:id="colCodigo" prefWidth="150.0" text="Código Catastral"/>
                    <TableColumn fx:id="colNombre" prefWidth="260.0" text="Nombre del Predio"/>
                    <TableColumn fx:id="colDireccion" prefWidth="320.0" text="Dirección / Sector"/>
                    <TableColumn fx:id="colArea" prefWidth="150.0" text="Área Calculada (m²)"/>
                    <TableColumn fx:id="colEstado" prefWidth="150.0" text="Estado Actual"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- PANEL INFERIOR DE DICTAMEN TÉCNICO -->
    <bottom>
        <VBox spacing="12.0" styleClass="dictamen-panel">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="14.0"/>
            </padding>
            <Separator/>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="section-header" text="Emisión de Dictamen Técnico Motivado"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblMensajeFeedback" text="Seleccione una solicitud de la tabla para auditar."/>
            </HBox>

            <HBox spacing="16.0" alignment="CENTER_LEFT">
                <TextArea fx:id="txtObservacionesDictamen" prefHeight="76.0"
                          promptText="Ingrese las observaciones técnicas, concepto jurídico o justificación obligatoria en caso de rechazo..."
                          styleClass="text-area-input" wrapText="true" HBox.hgrow="ALWAYS"/>

                <VBox spacing="8.0" prefWidth="250.0">
                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                            onAction="#inspeccionarEnMapa" styleClass="btn-secondary" text="🗺️ Inspeccionar en Mapa"/>
                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                            onAction="#aprobarSolicitudSeleccionada" styleClass="btn-success-lg" text="✔ Aprobar Incorporación"/>
                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                            onAction="#rechazarSolicitudSeleccionada" styleClass="btn-danger-lg" text="✖ Rechazar Solicitud"/>
                </VBox>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
