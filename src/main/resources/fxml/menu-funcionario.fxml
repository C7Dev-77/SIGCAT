<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Vista del menú del Funcionario - SIGCAT (Fase 4)
    Responsable original del stub: Leider Barreto (UI/UX)
    Panel real implementado por: Andrés Diaz (Desarrollador Core)
    Controlador: com.sigcat.controllers.MenuFuncionarioController
-->
<VBox alignment="TOP_CENTER" spacing="16.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sigcat.controllers.MenuFuncionarioController"
      styleClass="menu-root"
      prefWidth="900" prefHeight="650">

    <padding>
        <Insets top="40.0" right="60.0" bottom="40.0" left="60.0"/>
    </padding>

    <Label text="SIGCAT" styleClass="login-title"/>
    <Label text="Panel del Funcionario" styleClass="login-subtitle"/>
    <Label fx:id="lblBienvenida" styleClass="menu-welcome"/>

    <TableView fx:id="tablaSolicitudes" prefHeight="380" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60">
                <cellValueFactory>
                    <javafx.scene.control.cell.PropertyValueFactory property="id"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colPropietario" text="Propietario" prefWidth="220">
                <cellValueFactory>
                    <javafx.scene.control.cell.PropertyValueFactory property="propietario"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colArea" text="Área" prefWidth="120">
                <cellValueFactory>
                    <javafx.scene.control.cell.PropertyValueFactory property="area"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120">
                <cellValueFactory>
                    <javafx.scene.control.cell.PropertyValueFactory property="estado"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="140">
                <cellValueFactory>
                    <javafx.scene.control.cell.PropertyValueFactory property="fecha"/>
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <Label fx:id="lblMensaje" styleClass="field-label" wrapText="true"/>

    <HBox alignment="CENTER" spacing="16.0">
        <Button fx:id="btnAprobar" text="Aprobar" onAction="#handleAprobar" styleClass="btn-primary"/>
        <Button fx:id="btnRechazar" text="Rechazar" onAction="#handleRechazar" styleClass="btn-secondary"/>
    </HBox>

    <Button text="Cerrar sesión"
            onAction="#handleCerrarSesion"
            styleClass="btn-secondary"
            maxWidth="320"/>
</VBox>