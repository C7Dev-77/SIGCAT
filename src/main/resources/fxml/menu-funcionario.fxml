<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sigcat.controllers.MenuFuncionarioController"
            styleClass="gis-root"
            prefWidth="1100" prefHeight="680">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="gis-navbar" prefHeight="56.0" minHeight="56.0">
            <padding>
                <Insets left="20.0" right="20.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS" prefWidth="0.0">
                <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                         fill="#3b82f6" fillRule="EVEN_ODD"/>
                <Label text="SIGCAT" styleClass="gis-logo"/>
                <Label text="Funcionario Catastral" styleClass="gis-username"/>
            </HBox>

            <HBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS" prefWidth="0.0">
                <StackPane>
                    <Circle radius="16.0" fill="#3b82f6"/>
                    <Label fx:id="lblIniciales" styleClass="gis-avatar-text"/>
                </StackPane>
                <Label fx:id="lblUsuario" styleClass="gis-username"/>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="12.0" HBox.hgrow="ALWAYS" prefWidth="0.0">
                <Button fx:id="btnCampana" onAction="#handleCampana" styleClass="bell-btn">
                    <graphic>
                        <StackPane prefWidth="24.0" prefHeight="24.0" minWidth="24.0" minHeight="24.0">
                            <SVGPath content="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
                                     fill="#cbd5e1"/>
                            <Circle fx:id="puntoAlerta" radius="4.0" fill="#ef4444" StackPane.alignment="TOP_RIGHT"/>
                        </StackPane>
                    </graphic>
                </Button>
                <Button text="Cerrar sesión" onAction="#handleCerrarSesion" styleClass="btn-secondary"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <HBox spacing="18.0">
            <padding>
                <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
            </padding>

            <!-- Panel izquierdo: resumen y tabla -->
            <VBox spacing="14.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <HBox spacing="14.0">
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label fx:id="lblPendientes" text="0" styleClass="stat-number-pendiente"/>
                        <Label text="Pendientes" styleClass="stat-caption"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label fx:id="lblAprobados" text="0" styleClass="stat-number-aprobado"/>
                        <Label text="Aprobadas" styleClass="stat-caption"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label fx:id="lblRechazados" text="0" styleClass="stat-number-rechazado"/>
                        <Label text="Rechazadas" styleClass="stat-caption"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="SOLICITUDES" styleClass="gis-section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Mostrar:" styleClass="gis-input-label"/>
                    <ComboBox fx:id="cmbFiltro" styleClass="combo-oscuro" prefWidth="150.0"/>
                </HBox>

                <TableView fx:id="tablaSolicitudes" styleClass="tabla-oscura" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50">
                            <cellValueFactory>
                                <PropertyValueFactory property="id"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colPropietario" text="Propietario" prefWidth="220">
                            <cellValueFactory>
                                <PropertyValueFactory property="propietario"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colArea" text="Área" prefWidth="90">
                            <cellValueFactory>
                                <PropertyValueFactory property="area"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="110">
                            <cellValueFactory>
                                <PropertyValueFactory property="fecha"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <Label fx:id="lblMensaje" styleClass="gis-mensaje" wrapText="true"/>
            </VBox>

            <!-- Panel derecho: detalle del expediente -->
            <VBox styleClass="detalle-card" spacing="10.0"
                  prefWidth="380.0" minWidth="380.0" maxWidth="380.0">
                <padding>
                    <Insets top="18.0" right="20.0" bottom="18.0" left="20.0"/>
                </padding>

                <Label text="DETALLE DEL EXPEDIENTE" styleClass="gis-section-title"/>
                <Label fx:id="lblDetalleTitulo" styleClass="detalle-titulo"/>
                <Label fx:id="lblDetallePropietario" styleClass="gis-input-label" wrapText="true"/>

                <StackPane styleClass="mapa-marco">
                    <Canvas fx:id="canvasMapa" width="338.0" height="230.0"/>
                </StackPane>
                <Label text="Naranja: expediente  ·  Gris: aprobados  ·  Rojo: conflicto"
                       styleClass="gis-input-label" wrapText="true"/>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="2.0">
                        <Label text="Área" styleClass="gis-area-caption"/>
                        <Label fx:id="lblDetalleArea" styleClass="detalle-area"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox spacing="4.0" alignment="CENTER_RIGHT">
                        <Label text="Validación de linderos" styleClass="gis-area-caption"/>
                        <Label fx:id="lblLinderos" text="Sin datos" styleClass="pill-neutro"/>
                    </VBox>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox spacing="10.0">
                    <Button fx:id="btnAprobar" text="Aprobar Registro" onAction="#handleAprobar"
                            styleClass="btn-aprobar-outline" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            disable="true"/>
                    <Button fx:id="btnRechazar" text="Rechazar" onAction="#handleRechazar"
                            styleClass="btn-rechazar-outline" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            disable="true"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>