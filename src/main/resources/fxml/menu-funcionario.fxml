<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.sigcat.controllers.MenuFuncionarioController"
    styleClass="admin-root"
    stylesheets="@../styles/admin-dashboard.css"
    prefWidth="1300.0" prefHeight="820.0">

    <!-- ================================================================= -->
    <!-- SIDEBAR LATERAL (FUNCIONARIO CATASTRAL)                           -->
    <!-- ================================================================= -->
    <left>
        <VBox spacing="14.0" styleClass="admin-sidebar">
            <padding>
                <Insets top="24.0" right="16.0" bottom="20.0" left="16.0" />
            </padding>

            <!-- AVATAR Y PERFIL DEL FUNCIONARIO -->
            <VBox alignment="CENTER" spacing="8.0">
                <StackPane>
                    <Circle radius="34.0" styleClass="avatar-circle" />
                    <Label text="🏛️" style="-fx-font-size: 28px;" />
                </StackPane>
                <Label fx:id="lblFuncionarioNombre" text="CARLOS PÉREZ" styleClass="admin-name" />
                <Label fx:id="lblFuncionarioRol" text="FUNCIONARIO CATASTRAL"
                    styleClass="admin-role" />
            </VBox>

            <Separator style="-fx-opacity: 0.25;" />

            <!-- BOTONES DE NAVEGACIÓN -->
            <VBox spacing="6.0">
                <Button maxWidth="1.7976931348623157E308" text="📥  BANDEJA DE SOLICITUDES"
                    styleClass="sidebar-nav-btn, sidebar-nav-btn-active"
                    onAction="#cargarSolicitudesPorFiltro" />
                <Button maxWidth="1.7976931348623157E308" text="🗺️  INSPECCIONAR EN MAPA"
                    styleClass="sidebar-nav-btn" onAction="#inspeccionarEnMapa" />
                <Button maxWidth="1.7976931348623157E308" text="📁  EXPEDIENTE Y DOCUMENTOS"
                    styleClass="sidebar-nav-btn" onAction="#verDocumentosSeleccionado" />
                <Button maxWidth="1.7976931348623157E308" text="📄  CERTIFICADO CATASTRAL PDF"
                    styleClass="sidebar-nav-btn" onAction="#abrirCertificadoSeleccionado" />
                <Button maxWidth="1.7976931348623157E308" text="🔄  ACTUALIZAR BANDEJA"
                    styleClass="sidebar-nav-btn" onAction="#cargarSolicitudesPorFiltro" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- CERRAR SESIÓN -->
            <Button maxWidth="1.7976931348623157E308" text="🚪  Cerrar Sesión"
                styleClass="sidebar-logout-btn" onAction="#cerrarSesion" />
        </VBox>
    </left>

    <!-- ================================================================= -->
    <!-- ÁREA CENTRAL DE AUDITORÍA Y DICTAMEN CATASTRAL                    -->
    <!-- ================================================================= -->
    <center>
        <VBox spacing="0.0">

            <!-- BARRA SUPERIOR DE FILTRO Y ESTADO -->
            <HBox spacing="16.0" styleClass="admin-topbar">
                <Label
                    text="SIGCAT — Consola de Funcionario Catastral (Alcaldía de Sincelejo, DANE 70001)"
                    styleClass="topbar-title" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="8.0" alignment="CENTER">
                    <Label text="Filtrar por Estado:"
                        style="-fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
                    <ComboBox fx:id="cmbFiltroEstado" prefWidth="220.0" styleClass="combo-input" />
                </HBox>
            </HBox>

            <!-- CUERPO PRINCIPAL CON SCROLL -->
            <VBox spacing="16.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="16.0" right="22.0" bottom="20.0" left="22.0" />
                </padding>

                <!-- ─── 1. TARJETAS KPI DE SOLICITUDES ─── -->
                <HBox spacing="18.0">
                    <VBox HBox.hgrow="ALWAYS" styleClass="kpi-gradient-blue" spacing="4.0">
                        <Label text="SOLICITUDES PENDIENTES" styleClass="kpi-label" />
                        <Label fx:id="lblResumenPendientes" text="0" styleClass="kpi-value" />
                        <Label text="Expedientes esperando dictamen técnico"
                            styleClass="kpi-subtext" />
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" styleClass="kpi-gradient-green" spacing="4.0">
                        <Label text="PREDIOS APROBADOS" styleClass="kpi-label" />
                        <Label fx:id="lblResumenAprobados" text="0" styleClass="kpi-value" />
                        <Label text="Predios incorporados a la malla oficial"
                            styleClass="kpi-subtext" />
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" styleClass="kpi-gradient-purple" spacing="4.0">
                        <Label text="GESTIÓN CATASTRAL" styleClass="kpi-label" />
                        <Label fx:id="lblResumenRechazados" text="Sincelejo, Sucre"
                            styleClass="kpi-value" />
                        <Label text="Validación de linderos WGS84 con JTS" styleClass="kpi-subtext" />
                    </VBox>
                </HBox>

                <!-- ─── 2. TABLA DE SOLICITUDES CATASTRALES ─── -->
                <VBox VBox.vgrow="ALWAYS" styleClass="content-card" spacing="10.0">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="BANDEJA DE SOLICITUDES RADICADAS POR CIUDADANOS"
                            styleClass="card-header-label" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Doble clic en una fila para auditar sobre el mapa satelital"
                            style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                    </HBox>

                    <TableView fx:id="tablaSolicitudes" VBox.vgrow="ALWAYS" prefHeight="260.0"
                        styleClass="admin-table">
                        <columns>
                            <TableColumn fx:id="colCodigo" prefWidth="130.0" text="Código Catastral" />
                            <TableColumn fx:id="colNombre" prefWidth="200.0"
                                text="Nombre del Predio" />
                            <TableColumn fx:id="colDireccion" prefWidth="220.0"
                                text="Dirección / Sector" />
                            <TableColumn fx:id="colPropietario" prefWidth="170.0" text="Propietario" />
                            <TableColumn fx:id="colArea" prefWidth="130.0"
                                text="Área Calculada (m²)" />
                            <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado Actual" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- ─── 3. PANEL DE DICTAMEN TÉCNICO MOTIVADO ─── -->
                <VBox styleClass="content-card" spacing="12.0">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="⚖️ EMISIÓN DE DICTAMEN TÉCNICO MOTIVADO"
                            styleClass="card-header-label" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblMensajeFeedback"
                            text="Seleccione un predio de la tabla para dictaminar."
                            style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
                    </HBox>

                    <TextArea fx:id="txtObservacionesDictamen" prefRowCount="2"
                        promptText="Ingrese las observaciones técnicas, concepto jurídico o justificación obligatoria en caso de rechazo..."
                        styleClass="search-box" style="-fx-font-size: 12px;" />

                    <HBox spacing="10.0" alignment="CENTER_RIGHT">
                        <Button text="🗺️ Inspeccionar en Mapa" styleClass="btn-action-primary"
                            onAction="#inspeccionarEnMapa" />
                        <Button text="📁 Ver Documentos" styleClass="btn-action-primary"
                            onAction="#verDocumentosSeleccionado" />
                        <Button text="📄 Ver Certificado PDF" styleClass="btn-action-primary"
                            onAction="#abrirCertificadoSeleccionado" />
                        <Button text="✏️ Editar Datos" styleClass="btn-action-primary"
                            onAction="#editarPredioSeleccionado" />
                        <Button text="🗑️ Eliminar" styleClass="btn-action-danger"
                            onAction="#eliminarPredioSeleccionado" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="✔ Aprobar Incorporación" styleClass="btn-action-success"
                            onAction="#aprobarSolicitudSeleccionada" />
                        <Button text="✖ Rechazar Solicitud" styleClass="btn-action-danger"
                            onAction="#rechazarSolicitudSeleccionada" />
                    </HBox>
                </VBox>

            </VBox>
        </VBox>
    </center>

</BorderPane>