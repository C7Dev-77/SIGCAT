<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!--
    Vista del menú del Funcionario - SIGCAT (PLACEHOLDER — Fase 4)
    Responsable: Leider Barreto (UI/UX) — stub de navegación
    Controlador: com.sigcat.controllers.MenuFuncionarioController

    NOTA: El panel real (TableView de solicitudes, botones Aprobar/Rechazar)
    será implementado por Andrés en la Fase 4.
-->
<VBox alignment="CENTER" spacing="20.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sigcat.controllers.MenuFuncionarioController"
      styleClass="menu-root"
      prefWidth="800" prefHeight="600">

    <padding>
        <Insets top="60.0" right="80.0" bottom="60.0" left="80.0"/>
    </padding>

    <Label text="SIGCAT" styleClass="login-title"/>
    <Label text="Panel del Funcionario" styleClass="login-subtitle"/>

    <Label fx:id="lblBienvenida" styleClass="menu-welcome"/>

    <!-- Placeholder: Andrés implementa el panel real en Fase 4 -->
    <Label text="⏳  Panel de gestión de solicitudes — Próximamente (Fase 4)"
           styleClass="field-label" wrapText="true"/>

    <Button text="Cerrar sesión"
            onAction="#handleCerrarSesion"
            styleClass="btn-secondary"
            maxWidth="320"/>
</VBox>
