<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.sigcat.controllers.MenuFuncionarioController"
    styleClass="admin-root"
    stylesheets="@../styles/admin-dashboard.css"
    prefWidth="1300.0" prefHeight="820.0">

    <!-- ================================================================= -->
    <!-- SIDEBAR LATERAL (FUNCIONARIO CATASTRAL)                           -->
    <!-- ================================================================= -->
    <left>
        <VBox spacing="14.0" styleClass="admin-sidebar">
            <padding>
                <Insets top="24.0" right="16.0" bottom="20.0" left="16.0" />
            </padding>

            <!-- AVATAR Y PERFIL DEL FUNCIONARIO -->
            <VBox alignment="CENTER" spacing="8.0">
                <StackPane>
                    <Circle radius="34.0" styleClass="avatar-circle" />
                    <Label text="🏛" style="-fx-font-size: 28px;" />
                </StackPane>
                <Label fx:id="lblFuncionarioNombre" text="CARLOS PÉREZ" styleClass="admin-name" />
                <Label fx:id="lblFuncionarioRol" text="FUNCIONARIO CATASTRAL"
                    styleClass="admin-role" />
            </VBox>

            <Separator style="-fx-opacity: 0.25;" />

            <!-- BOTONES DE NAVEGACIÓN -->
            <VBox spacing="6.0">
                <Button fx:id="btnNavBandeja" maxWidth="1.7976931348623157E308" text="📥  Bandeja de solicitudes"
                    styleClass="sidebar-nav-btn, sidebar-nav-btn-active"
                    onAction="#mostrarBandeja" />
                <Button fx:id="btnNavResumen" maxWidth="1.7976931348623157E308" text="📊  Resumen mensual"
                    styleClass="sidebar-nav-btn" onAction="#mostrarResumenMensual" />
                <Button maxWidth="1.7976931348623157E308" text="🗺  Inspeccionar en mapa"
                    styleClass="sidebar-nav-btn" onAction="#inspeccionarEnMapa" />
                <Button maxWidth="1.7976931348623157E308" text="📁  Expediente y documentos"
                    styleClass="sidebar-nav-btn" onAction="#verDocumentosSeleccionado" />
                <Button maxWidth="1.7976931348623157E308" text="📄  Certificado catastral"
                    styleClass="sidebar-nav-btn" onAction="#abrirCertificadoSeleccionado" />
                <Button maxWidth="1.7976931348623157E308" text="🔄  Actualizar bandeja"
                    styleClass="sidebar-nav-btn" onAction="#cargarSolicitudesPorFiltro" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- CERRAR SESIÓN -->
            <Button maxWidth="1.7976931348623157E308" text="🚪  Cerrar Sesión"
                styleClass="sidebar-logout-btn" onAction="#cerrarSesion" />
        </VBox>
    </left>

    <!-- ================================================================= -->
    <!-- ÁREA CENTRAL DE AUDITORÍA Y DICTAMEN CATASTRAL                    -->
    <!-- ================================================================= -->
    <center>
        <VBox spacing="0.0">

            <!-- BARRA SUPERIOR DE FILTRO Y ESTADO -->
            <HBox spacing="16.0" styleClass="admin-topbar">
                <VBox spacing="2.0">
                    <Label text="Consola del Funcionario Catastral" styleClass="topbar-title" />
                    <Label text="Alcaldía de Sincelejo · DANE 70001" styleClass="card-hint-label" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox fx:id="boxFiltroEstado" spacing="8.0" alignment="CENTER">
                    <Label text="Filtrar por estado:" styleClass="filtro-label" />
                    <ComboBox fx:id="cmbFiltroEstado" prefWidth="230.0" styleClass="combo-input" />
                </HBox>
            </HBox>

            <!-- CUERPO PRINCIPAL CON SCROLL -->
            <VBox spacing="16.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="16.0" right="22.0" bottom="20.0" left="22.0" />
                </padding>

                <!-- ─── 1. TARJETAS KPI (mismos colores de estado que el portal del propietario) ─── -->
                <HBox spacing="16.0">
                    <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card-warning" spacing="3.0">
                        <Label text="SOLICITUDES PENDIENTES" styleClass="kpi-title" />
                        <Label fx:id="lblResumenPendientes" text="0" styleClass="kpi-number" />
                        <Label text="Esperando dictamen técnico" styleClass="kpi-subtext" />
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card-success" spacing="3.0">
                        <Label text="PREDIOS APROBADOS" styleClass="kpi-title" />
                        <Label fx:id="lblResumenAprobados" text="0" styleClass="kpi-number" />
                        <Label text="Incorporados a la malla oficial" styleClass="kpi-subtext" />
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card-danger" spacing="3.0">
                        <Label text="SOLICITUDES RECHAZADAS" styleClass="kpi-title" />
                        <Label fx:id="lblResumenRechazados" text="0" styleClass="kpi-number" />
                        <Label text="Con dictamen desfavorable" styleClass="kpi-subtext" />
                    </VBox>
                </HBox>

                <StackPane VBox.vgrow="ALWAYS">

                    <!-- ═══ VISTA A: BANDEJA DE SOLICITUDES ═══ -->
                    <VBox fx:id="panelBandeja" spacing="16.0">
                        <!-- ─── 2. TABLA DE SOLICITUDES CATASTRALES ─── -->
                        <VBox VBox.vgrow="ALWAYS" styleClass="content-card" spacing="10.0">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label text="Bandeja de solicitudes radicadas"
                                    styleClass="card-header-label" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="Doble clic en una fila para inspeccionarla en el mapa"
                                    styleClass="card-hint-label" />
                            </HBox>

                            <TableView fx:id="tablaSolicitudes" VBox.vgrow="ALWAYS" prefHeight="260.0"
                                styleClass="admin-table">
                                <columns>
                                    <TableColumn fx:id="colCodigo" prefWidth="130.0" text="Código Catastral" />
                                    <TableColumn fx:id="colNombre" prefWidth="200.0"
                                        text="Nombre del Predio" />
                                    <TableColumn fx:id="colDireccion" prefWidth="220.0"
                                        text="Dirección / Sector" />
                                    <TableColumn fx:id="colPropietario" prefWidth="170.0" text="Propietario" />
                                    <TableColumn fx:id="colArea" prefWidth="130.0"
                                        text="Área Calculada (m²)" />
                                    <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado Actual" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                        <!-- ─── 3. PANEL DE DICTAMEN TÉCNICO MOTIVADO ─── -->
                        <VBox styleClass="content-card" spacing="10.0">
                            <Label text="⚖ Dictamen técnico de la solicitud seleccionada"
                                styleClass="card-header-label" />

                            <TextArea fx:id="txtObservacionesDictamen" prefRowCount="2" wrapText="true"
                                promptText="Observaciones técnicas o concepto jurídico (obligatorio para rechazar)..."
                                styleClass="search-box" />

                            <Label fx:id="lblMensajeFeedback" wrapText="true" maxWidth="1.7976931348623157E308"
                                text="Seleccione un predio de la tabla para dictaminar."
                                styleClass="feedback-text" />

                            <!-- Acciones de consulta a la izquierda; decisión a la derecha.
                                 minWidth="-Infinity" evita que JavaFX recorte el texto ("Eli..."). -->
                            <HBox spacing="12.0" alignment="CENTER_LEFT">
                                <FlowPane hgap="8.0" vgap="8.0" HBox.hgrow="ALWAYS" prefWrapLength="520.0">
                                    <Button text="🗺 Ver en mapa" styleClass="btn-action-primary" minWidth="-Infinity"
                                        onAction="#inspeccionarEnMapa" />
                                    <Button text="📁 Documentos" styleClass="btn-action-primary" minWidth="-Infinity"
                                        onAction="#verDocumentosSeleccionado" />
                                    <Button text="📄 Certificado" styleClass="btn-action-primary" minWidth="-Infinity"
                                        onAction="#abrirCertificadoSeleccionado" />
                                    <Button text="✏ Editar" styleClass="btn-action-primary" minWidth="-Infinity"
                                        onAction="#editarPredioSeleccionado" />
                                    <Button text="🗑 Eliminar" styleClass="btn-action-danger-outline" minWidth="-Infinity"
                                        onAction="#eliminarPredioSeleccionado" />
                                </FlowPane>
                                <Button text="✖ Rechazar" styleClass="btn-action-danger" minWidth="-Infinity"
                                    onAction="#rechazarSolicitudSeleccionada" />
                                <Button text="✔ Aprobar" styleClass="btn-action-success" minWidth="-Infinity"
                                    onAction="#aprobarSolicitudSeleccionada" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- ═══ VISTA B: RESUMEN MENSUAL DE GESTIÓN ═══ -->
                    <VBox fx:id="panelResumen" spacing="12.0" visible="false" managed="false"
                        styleClass="content-card">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="📊 Resumen mensual de gestión catastral"
                                styleClass="card-header-label" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Año:" styleClass="filtro-label" />
                            <ComboBox fx:id="cmbAnioResumen" prefWidth="150.0" styleClass="combo-input"
                                onAction="#onFiltroResumen" />
                            <Label text="Mostrar:" styleClass="filtro-label" />
                            <ComboBox fx:id="cmbDatoResumen" prefWidth="190.0" styleClass="combo-input"
                                onAction="#onFiltroResumen" />
                            <Button text="🔄 Actualizar" styleClass="btn-action-primary" minWidth="-Infinity"
                                onAction="#actualizarResumenMensual" />
                        </HBox>

                        <HBox spacing="16.0" VBox.vgrow="ALWAYS">
                            <TableView fx:id="tablaResumen" HBox.hgrow="ALWAYS" prefWidth="560.0"
                                styleClass="admin-table">
                                <columns>
                                    <TableColumn fx:id="colResMes" prefWidth="150.0" text="Mes" sortable="false" />
                                    <TableColumn fx:id="colResRegistrados" prefWidth="100.0" text="Registrados" />
                                    <TableColumn fx:id="colResPendientes" prefWidth="100.0" text="Pendientes" />
                                    <TableColumn fx:id="colResAprobados" prefWidth="100.0" text="Aprobados" />
                                    <TableColumn fx:id="colResRechazados" prefWidth="100.0" text="Rechazados" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="No hay solicitudes registradas en el periodo seleccionado."
                                        styleClass="resumen-nota" />
                                </placeholder>
                            </TableView>

                            <BarChart fx:id="graficoResumen" HBox.hgrow="ALWAYS" prefWidth="460.0"
                                animated="false" legendVisible="true" styleClass="resumen-chart">
                                <xAxis>
                                    <CategoryAxis fx:id="ejeMeses" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="ejeCantidad" label="Solicitudes" minorTickVisible="false"
                                        tickUnit="1.0" />
                                </yAxis>
                            </BarChart>
                        </HBox>

                        <Label fx:id="lblTotalesResumen" styleClass="resumen-totales" wrapText="true" />
                        <Label wrapText="true" styleClass="resumen-nota"
                            text="Registrados: solicitudes radicadas en el mes (pendientes: cuántas de ellas siguen sin dictamen). Aprobados y rechazados: dictámenes emitidos en el mes. No incluye los predios públicos de la capa base." />
                    </VBox>
                </StackPane>

            </VBox>
        </VBox>
    </center>

</BorderPane>