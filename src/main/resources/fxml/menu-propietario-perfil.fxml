<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Vista de Perfil de Propietario y Centro de Gestión Documental Legal - SIGCAT v2.0
    Controlador: com.sigcat.controllers.MenuPropietarioPerfilController
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sigcat.controllers.MenuPropietarioPerfilController"
            styleClass="menu-root"
            prefWidth="1280.0" prefHeight="780.0">

    <!-- TOP NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-navbar">
            <padding>
                <Insets bottom="14.0" left="24.0" right="24.0" top="14.0"/>
            </padding>
            <VBox spacing="2.0">
                <Label styleClass="navbar-title" text="SIGCAT — Perfil de Propietario y Gestión Documental"/>
                <Label fx:id="lblSubtituloNav" styleClass="navbar-subtitle" text="Administración de Cuenta, Soportes Legales y Recibos Catastrales"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button mnemonicParsing="false" onAction="#volverAlMenuPropietario" styleClass="btn-secondary" text="⬅ Volver a Mis Predios"/>
            <Button mnemonicParsing="false" onAction="#irAlMapa" styleClass="btn-secondary" text="🗺️ Ver en Mapa"/>
            <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="btn-outline" text="🚪 Salir"/>
        </HBox>
    </top>

    <!-- MAIN SPLIT: PERFIL A LA IZQUIERDA, DOCUMENTOS A LA DERECHA -->
    <center>
        <HBox spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/>
            </padding>

            <!-- COLUMNA IZQUIERDA: PERFIL Y CUENTA -->
            <VBox prefWidth="380.0" spacing="14.0" styleClass="sidebar-card">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>

                <Label styleClass="section-header" text="👤 Mi Cuenta y Datos Personales"/>
                <Separator/>

                <!-- AVATAR Y FOTO -->
                <HBox alignment="CENTER" spacing="16.0">
                    <StackPane prefHeight="80.0" prefWidth="80.0" style="-fx-background-color: #334155; -fx-background-radius: 40; -fx-border-color: #5C6BC0; -fx-border-width: 2; -fx-border-radius: 40;">
                        <ImageView fx:id="imgAvatar" fitHeight="76.0" fitWidth="76.0" pickOnBounds="true" preserveRatio="true"/>
                        <Label fx:id="lblAvatarLetra" text="👤" style="-fx-font-size: 32px; -fx-text-fill: #cbd5e1;"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblNombreDisplay" text="Propietario" style="-fx-text-fill: #f8fafc; -fx-font-weight: bold; -fx-font-size: 14px;" wrapText="true"/>
                        <Label styleClass="hero-badge" text="PROPIETARIO CATASTRAL"/>
                        <Button mnemonicParsing="false" onAction="#cambiarAvatar" styleClass="btn-outline" text="📷 Cambiar Foto"/>
                    </VBox>
                </HBox>

                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="Documento de Identidad (Cédula/NIT)"/>
                    <TextField fx:id="txtDocumento" editable="false" style="-fx-background-color: #0f172a; -fx-text-fill: #94a3b8; -fx-border-color: #334155; -fx-border-radius: 6;"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="Nombre Completo *"/>
                    <TextField fx:id="txtNombre" promptText="Nombre y apellidos" styleClass="text-input"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="Correo Electrónico"/>
                    <TextField fx:id="txtEmail" promptText="ejemplo@correo.com" styleClass="text-input"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="Teléfono / Celular"/>
                    <TextField fx:id="txtTelefono" promptText="Ej: 300 123 4567" styleClass="text-input"/>
                </VBox>

                <Separator/>
                <Label styleClass="section-header" text="🔒 Seguridad y Contraseña"/>

                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="Nueva Contraseña (opcional)"/>
                    <PasswordField fx:id="txtPasswordNueva" promptText="Dejar en blanco para conservar" styleClass="text-input"/>
                </VBox>

                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="Confirmar Contraseña"/>
                    <PasswordField fx:id="txtPasswordConfirmar" promptText="Confirmar nueva contraseña" styleClass="text-input"/>
                </VBox>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardarPerfil" styleClass="btn-primary" text="💾 Guardar Cambios de Cuenta"/>
                <Label fx:id="lblEstadoPerfil" text="" wrapText="true"/>
            </VBox>

            <!-- COLUMNA DERECHA: EXPEDIENTE Y GESTIÓN DOCUMENTAL DE PREDIOS -->
            <VBox spacing="14.0" styleClass="sidebar-card" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets bottom="20.0" left="22.0" right="22.0" top="20.0"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="2.0">
                        <Label styleClass="section-header" text="📑 Expediente Documental Legal del Predio"/>
                        <Label styleClass="navbar-subtitle" text="Sube escrituras públicas, recibos catastrales y certificados oficiales a Supabase Storage"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button mnemonicParsing="false" onAction="#subirDocumentoNuevo" styleClass="btn-indigo" text="☁️ Subir Soporte Legal / Recibo"/>
                    <Button mnemonicParsing="false" onAction="#recargarDocumentos" styleClass="btn-secondary" text="🔄 Refrescar"/>
                </HBox>

                <Separator/>

                <!-- BARRA DE SELECCIÓN DE PREDIO -->
                <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: #0f172a; -fx-padding: 12; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <Label styleClass="field-label" text="Seleccionar Predio:"/>
                    <ComboBox fx:id="cmbMisPredios" prefWidth="380.0" styleClass="combo-input"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblPredioCodigo" styleClass="hero-badge" text="70001-XXXX"/>
                    <Label fx:id="lblPredioEstado" styleClass="badge-aprobado" text="ESTADO"/>
                </HBox>

                <!-- RESUMEN FICHA DEL PREDIO ACTIVO -->
                <HBox spacing="14.0">
                    <VBox styleClass="metric-box" HBox.hgrow="ALWAYS">
                        <Label styleClass="metric-title" text="DENOMINACIÓN / NOMBRE"/>
                        <Label fx:id="lblPredioNombre" text="Predio" style="-fx-text-fill: #38bdf8; -fx-font-weight: bold; -fx-font-size: 13px;" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="metric-box" HBox.hgrow="ALWAYS">
                        <Label styleClass="metric-title" text="DIRECCIÓN NOMENCLATURA"/>
                        <Label fx:id="lblPredioDireccion" text="Sincelejo, Sucre" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12px;" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="metric-box" prefWidth="160.0">
                        <Label styleClass="metric-title" text="ÁREA REGISTRADA"/>
                        <Label fx:id="lblPredioArea" text="0.00 m²" style="-fx-text-fill: #a78bfa; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    </VBox>
                </HBox>

                <!-- TABLA DE DOCUMENTOS LEGALES -->
                <TableView fx:id="tablaDocumentos" VBox.vgrow="ALWAYS" styleClass="modern-table">
                    <columns>
                        <TableColumn fx:id="colTipoDoc" prefWidth="160.0" text="Tipo de Documento"/>
                        <TableColumn fx:id="colNombreArchivo" prefWidth="240.0" text="Nombre del Archivo"/>
                        <TableColumn fx:id="colDescripcion" prefWidth="220.0" text="Descripción / Referencia"/>
                        <TableColumn fx:id="colFechaSubida" prefWidth="140.0" text="Fecha Subida"/>
                        <TableColumn fx:id="colEstadoDoc" prefWidth="140.0" text="Estado"/>
                        <TableColumn fx:id="colAcciones" prefWidth="180.0" text="Acciones"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #0f172a; -fx-padding: 10 14 10 14; -fx-background-radius: 6; -fx-border-color: #334155; -fx-border-radius: 6;">
                    <Label text="💡" style="-fx-font-size: 16px;"/>
                    <Label text="Para la certificación catastral formal en Sincelejo, adjunte su Escritura Pública debidamente registrada y el Recibo de Catastro o Paz y Salvo Municipal." style="-fx-text-fill: #94a3b8; -fx-font-size: 11.5px;"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>

