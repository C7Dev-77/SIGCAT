<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Registro de nuevo propietario - SIGCAT
    Misma tarjeta centrada que el inicio de sesión: a la izquierda los pasos
    del trámite, a la derecha el formulario.
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sigcat.controllers.RegistroController"
            prefHeight="640.0" prefWidth="960.0"
            styleClass="auth-root">
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="auth-scroll">
            <VBox alignment="CENTER" spacing="16.0">
                <padding>
                    <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                </padding>

                <HBox styleClass="auth-shell" maxWidth="-Infinity" maxHeight="-Infinity">

                    <!-- ─── PASOS DEL TRÁMITE ─── -->
                    <VBox prefWidth="360.0" spacing="16.0" styleClass="auth-hero-panel">
                        <padding>
                            <Insets top="40.0" right="36.0" bottom="32.0" left="36.0"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <StackPane styleClass="brand-mark">
                                <Label text="S" styleClass="brand-mark-text"/>
                            </StackPane>
                            <VBox spacing="1.0">
                                <Label text="SIGCAT" styleClass="brand-name"/>
                                <Label text="Alcaldía de Sincelejo" styleClass="brand-caption"/>
                            </VBox>
                        </HBox>

                        <Region prefHeight="12.0"/>

                        <Label styleClass="hero-badge" text="NUEVO PROPIETARIO"/>
                        <Label styleClass="hero-title" text="Cree su cuenta en tres pasos" wrapText="true"/>

                        <VBox spacing="14.0">
                            <padding>
                                <Insets top="6.0"/>
                            </padding>
                            <HBox spacing="12.0" alignment="TOP_LEFT">
                                <Label text="1" styleClass="step-number" minWidth="-Infinity"/>
                                <Label styleClass="hero-feature" wrapText="true" text="Regístrese con su documento de identidad o NIT."/>
                            </HBox>
                            <HBox spacing="12.0" alignment="TOP_LEFT">
                                <Label text="2" styleClass="step-number" minWidth="-Infinity"/>
                                <Label styleClass="hero-feature" wrapText="true" text="Dibuje los linderos de su predio sobre el mapa y adjunte sus soportes."/>
                            </HBox>
                            <HBox spacing="12.0" alignment="TOP_LEFT">
                                <Label text="3" styleClass="step-number" minWidth="-Infinity"/>
                                <Label styleClass="hero-feature" wrapText="true" text="Un funcionario de la Alcaldía revisa la solicitud y emite el dictamen."/>
                            </HBox>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>
                        <Label styleClass="hero-footnote" text="Código DANE 70001 · Sincelejo, Sucre"/>
                    </VBox>

                    <!-- ─── FORMULARIO ─── -->
                    <VBox prefWidth="460.0" spacing="14.0" alignment="CENTER_LEFT" styleClass="auth-form-panel">
                        <padding>
                            <Insets top="36.0" right="44.0" bottom="32.0" left="44.0"/>
                        </padding>

                        <VBox spacing="4.0">
                            <Label styleClass="auth-title" text="Crear cuenta"/>
                            <Label styleClass="auth-subtitle" text="Los campos marcados con * son obligatorios."/>
                        </VBox>

                        <VBox spacing="6.0">
                            <Label styleClass="field-label" text="Documento de identidad (cédula o NIT) *"/>
                            <TextField fx:id="txtDocumentoRegistro" promptText="Ej: 1102854321" styleClass="text-input"/>
                        </VBox>

                        <VBox spacing="6.0">
                            <Label styleClass="field-label" text="Nombre completo o razón social *"/>
                            <TextField fx:id="txtNombreRegistro" promptText="Ej: Carlos Andrés Mendoza" styleClass="text-input"/>
                        </VBox>

                        <VBox spacing="6.0">
                            <Label styleClass="field-label" text="Contraseña *"/>
                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                <StackPane HBox.hgrow="ALWAYS">
                                    <PasswordField fx:id="txtPasswordRegistro" maxWidth="1.7976931348623157E308" promptText="Mínimo 6 caracteres"
                                                   styleClass="text-input"/>
                                </StackPane>
                                <Button fx:id="btnVerPassword" text="Mostrar" minWidth="-Infinity"
                                        styleClass="btn-toggle-password"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="6.0">
                            <Label styleClass="field-label" text="Confirmar contraseña *"/>
                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                <StackPane HBox.hgrow="ALWAYS">
                                    <PasswordField fx:id="txtConfirmarPassword" maxWidth="1.7976931348623157E308" promptText="Repita la contraseña"
                                                   styleClass="text-input"/>
                                </StackPane>
                                <Button fx:id="btnVerConfirmar" text="Mostrar" minWidth="-Infinity"
                                        styleClass="btn-toggle-password"/>
                            </HBox>
                            <Label fx:id="lblBloqMayus" text="⚠ Bloq Mayús está activado" styleClass="caps-warning"
                                   visible="false" managed="false"/>
                        </VBox>

                        <!-- Solo ocupa espacio cuando hay un mensaje (ver RegistroController.initialize) -->
                        <Label fx:id="lblMensajeRegistro" styleClass="feedback-label" wrapText="true"
                               maxWidth="1.7976931348623157E308"/>

                        <Button fx:id="btnRegistrar" defaultButton="true" maxWidth="1.7976931348623157E308"
                                mnemonicParsing="false" onAction="#registrarNuevoPropietario" styleClass="btn-primary-lg"
                                text="Crear cuenta"/>

                        <HBox alignment="CENTER" spacing="6.0">
                            <Label styleClass="auth-subtitle" text="¿Ya tiene una cuenta?"/>
                            <Hyperlink onAction="#volverALogin" styleClass="auth-link" text="Iniciar sesión"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Label styleClass="auth-footer" text="SIGCAT · Sistema de Información Geográfica y Catastral · Alcaldía de Sincelejo"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
