<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sigcat.controllers.MenuAdminController"
            styleClass="admin-root"
            stylesheets="@../styles/admin-dashboard.css"
            prefWidth="1300.0" prefHeight="820.0">

    <!-- ================================================================= -->
    <!-- SIDEBAR LATERAL (ADMINISTRADOR)                                   -->
    <!-- ================================================================= -->
    <left>
        <VBox spacing="14.0" styleClass="admin-sidebar">
            <padding>
                <Insets top="24.0" right="16.0" bottom="20.0" left="16.0"/>
            </padding>

            <!-- AVATAR Y PERFIL DEL ADMINISTRADOR -->
            <VBox alignment="CENTER" spacing="8.0">
                <StackPane>
                    <Circle fx:id="circleAvatar" radius="34.0" styleClass="avatar-circle"/>
                    <Label text="👤" style="-fx-font-size: 30px; -fx-text-fill: #93c5fd;"/>
                </StackPane>
                <Label fx:id="lblAdminNombre" text="ADMINISTRADOR SIGCAT" styleClass="admin-name"/>
                <Label fx:id="lblAdminRol" text="ADMINISTRADOR DEL SISTEMA" styleClass="admin-role"/>
            </VBox>

            <Separator style="-fx-opacity: 0.25;"/>

            <!-- BOTONES DE NAVEGACIÓN -->
            <VBox spacing="6.0">
                <Button fx:id="btnNavDashboard" maxWidth="1.7976931348623157E308" text="🏠  Inicio" styleClass="sidebar-nav-btn, sidebar-nav-btn-active" onAction="#mostrarDashboard"/>
                <Button fx:id="btnNavAuditoria" maxWidth="1.7976931348623157E308" text="📋  Auditoría" styleClass="sidebar-nav-btn" onAction="#mostrarAuditoria"/>
                <Button fx:id="btnNavUsuarios" maxWidth="1.7976931348623157E308" text="👥  Usuarios" styleClass="sidebar-nav-btn" onAction="#mostrarUsuarios"/>
                <Button fx:id="btnNavMapa" maxWidth="1.7976931348623157E308" text="🗺  Mapa de Sincelejo" styleClass="sidebar-nav-btn" onAction="#onVerEnMapa"/>
                <Button fx:id="btnNavSync" maxWidth="1.7976931348623157E308" text="🔄  Sincronizar nube" styleClass="sidebar-nav-btn" onAction="#onSincronizarSupabase"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- CERRAR SESIÓN -->
            <Button maxWidth="1.7976931348623157E308" text="🚪  Cerrar Sesión" styleClass="sidebar-logout-btn" onAction="#cerrarSesion"/>
        </VBox>
    </left>

    <!-- ================================================================= -->
    <!-- ÁREA CENTRAL DE CONTENIDO                                         -->
    <!-- ================================================================= -->
    <center>
        <VBox spacing="0.0">

            <!-- BARRA SUPERIOR DE BÚSQUEDA Y ESTADO -->
            <HBox spacing="16.0" styleClass="admin-topbar">
                <Label text="SIGCAT — Panel de Administración Catastral (Sincelejo, Sucre)" styleClass="topbar-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtBuscar" promptText="🔍 Buscar por código, predio o propietario..." styleClass="search-box"/>
                <Label fx:id="lblSyncStatus" text="🟢 Supabase En Línea" styleClass="sync-badge-online"/>
            </HBox>

            <!-- CONTENEDOR MULTI-VISTA -->
            <StackPane VBox.vgrow="ALWAYS">

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- VISTA 1: DASHBOARD / MÉTRICAS EJECUTIVAS                    -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <ScrollPane fx:id="paneDashboard" fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <VBox spacing="18.0">
                        <padding>
                            <Insets top="18.0" right="22.0" bottom="22.0" left="22.0"/>
                        </padding>

                        <!-- ─── 1. FILA DE TARJETAS KPI GRADIENTES ─── -->
                        <HBox spacing="18.0">
                            <!-- KPI 1: TURQUESA -->
                            <VBox HBox.hgrow="ALWAYS" styleClass="kpi-gradient-green" spacing="4.0">
                                <Label text="TOTAL PREDIOS EN MALLA" styleClass="kpi-label"/>
                                <Label fx:id="lblTotalPredios" text="11 Predios" styleClass="kpi-value"/>
                                <Label fx:id="lblAreaTotal" text="Área total: 109,151.95 m²" styleClass="kpi-subtext"/>
                            </VBox>

                            <!-- KPI 2: AZUL / PERIWINKLE -->
                            <VBox HBox.hgrow="ALWAYS" styleClass="kpi-gradient-blue" spacing="4.0">
                                <Label text="USUARIOS DEL SISTEMA" styleClass="kpi-label"/>
                                <Label fx:id="lblSolicitudesAuditadas" text="3 Usuarios" styleClass="kpi-value"/>
                                <Label fx:id="lblResumenAuditadas" text="Propietarios, Funcionarios y Admin" styleClass="kpi-subtext"/>
                            </VBox>

                            <!-- KPI 3: VIOLETA -->
                            <VBox HBox.hgrow="ALWAYS" styleClass="kpi-gradient-purple" spacing="4.0">
                                <Label text="CONFORMIDAD TOPOLÓGICA" styleClass="kpi-label"/>
                                <Label fx:id="lblTasaAprobacion" text="100%" styleClass="kpi-value"/>
                                <Label fx:id="lblResumenNorma" text="0 invasiones a bienes públicos" styleClass="kpi-subtext"/>
                            </VBox>
                        </HBox>

                        <!-- ─── 2. FILA MEDIA: TABLA DE INVENTARIO Y GRÁFICO ─── -->
                        <HBox spacing="18.0">
                            <!-- COLUMNA IZQUIERDA: INVENTARIO DE PREDIOS (SOLO INSPECCIÓN) -->
                            <VBox prefWidth="640.0" styleClass="content-card" spacing="10.0">
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="INVENTARIO DE PREDIOS Y MALLA CATASTRAL" styleClass="card-header-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button minWidth="-Infinity" text="🔄 Refrescar" styleClass="btn-action-primary" onAction="#cargarDatosDashboard"/>
                                </HBox>

                                <TableView fx:id="tablaSolicitudes" VBox.vgrow="ALWAYS" prefHeight="260.0" styleClass="admin-table">
                                    <columns>
                                        <TableColumn fx:id="colCodigo" prefWidth="120.0" text="Código"/>
                                        <TableColumn fx:id="colNombre" prefWidth="150.0" text="Predio"/>
                                        <TableColumn fx:id="colPropietario" prefWidth="130.0" text="Propietario"/>
                                        <TableColumn fx:id="colArea" prefWidth="90.0" text="Área"/>
                                        <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado"/>
                                        <TableColumn fx:id="colSoporte" prefWidth="60.0" text="Soporte"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>

                                <!-- BOTÓN DE ACCIÓN EXCLUSIVO: INSPECCIÓN EN MAPA (SIN APROBAR/RECHAZAR) -->
                                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                                    <Button minWidth="-Infinity" text="🗺 Inspeccionar en Mapa de Sincelejo" styleClass="btn-action-primary" onAction="#onVerEnMapa"/>
                                </HBox>
                            </VBox>

                            <!-- COLUMNA DERECHA: GRÁFICO DE TENDENCIA (AREACHART) -->
                            <VBox HBox.hgrow="ALWAYS" styleClass="content-card" spacing="8.0">
                                <Label text="RADICACIONES MENSUALES Y TENDENCIA CATASTRAL (SINCELEJO)" styleClass="card-header-label"/>
                                <AreaChart fx:id="chartTendencia" VBox.vgrow="ALWAYS" legendSide="TOP" createSymbols="true">
                                    <xAxis>
                                        <CategoryAxis label="Meses"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Trámites"/>
                                    </yAxis>
                                </AreaChart>
                            </VBox>
                        </HBox>

                        <!-- ─── 3. FILA INFERIOR: COBERTURA POR SECTORES Y DONUT ─── -->
                        <HBox spacing="18.0" prefHeight="170.0">
                            <!-- SECTOR PROGRESS BARS -->
                            <VBox HBox.hgrow="ALWAYS" styleClass="content-card" spacing="10.0">
                                <Label text="COBERTURA DE INCORPORACIÓN POR SECTORES" styleClass="card-header-label"/>
                                <VBox spacing="6.0">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Centro Histórico (Sincelejo):" styleClass="metric-row-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="75%" style="-fx-text-fill: #4ade80; -fx-font-weight: bold;"/>
                                    </HBox>
                                    <ProgressBar fx:id="progressCentro" progress="0.75" maxWidth="1.7976931348623157E308" styleClass="progress-bar, bar-verde"/>

                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Sector Norte (Universidad / Puerta Roja):" styleClass="metric-row-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="60%" style="-fx-text-fill: #fb923c; -fx-font-weight: bold;"/>
                                    </HBox>
                                    <ProgressBar fx:id="progressNorte" progress="0.60" maxWidth="1.7976931348623157E308" styleClass="progress-bar, bar-naranja"/>

                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Sector Majagual / San Carlos:" styleClass="metric-row-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="80%" style="-fx-text-fill: #c084fc; -fx-font-weight: bold;"/>
                                    </HBox>
                                    <ProgressBar fx:id="progressMajagual" progress="0.80" maxWidth="1.7976931348623157E308" styleClass="progress-bar, bar-morado"/>
                                </VBox>
                            </VBox>

                            <!-- DONUT CIRCLE INDICATOR -->
                            <VBox prefWidth="250.0" alignment="CENTER" styleClass="content-card" spacing="6.0">
                                <Label text="CUMPLIMIENTO NORMATIVO" styleClass="card-header-label"/>
                                <StackPane prefHeight="105.0" prefWidth="105.0">
                                    <Circle radius="42.0" styleClass="donut-circle-bg"/>
                                    <Circle radius="42.0" styleClass="donut-circle-value" strokeDashArray="190, 70"/>
                                    <VBox alignment="CENTER">
                                        <Label fx:id="lblDonutPercent" text="100%" styleClass="donut-percentage-text"/>
                                        <Label text="APROBADO" styleClass="donut-subtext"/>
                                    </VBox>
                                </StackPane>
                            </VBox>
                        </HBox>

                    </VBox>
                </ScrollPane>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- VISTA 2: AUDITORÍA FORENSE Y TRAZABILIDAD (audit_log)        -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <VBox fx:id="paneAuditoria" spacing="16.0" visible="false">
                    <padding>
                        <Insets top="20.0" right="24.0" bottom="24.0" left="24.0"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="3.0">
                            <Label text="📜 Historial de Auditoría Legal y Trazabilidad (audit_log)" styleClass="view-title"/>
                            <Label text="Registro forense inmutable de radicaciones, dictámenes y cambios de estado en Sincelejo." styleClass="view-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button minWidth="-Infinity" text="🔄 Refrescar Auditoría" styleClass="btn-action-primary" onAction="#cargarDatosAuditoria"/>
                    </HBox>

                    <TableView fx:id="tablaAuditoria" VBox.vgrow="ALWAYS" styleClass="admin-table">
                        <columns>
                            <TableColumn fx:id="colAudFecha" prefWidth="150.0" text="Fecha / Hora"/>
                            <TableColumn fx:id="colAudUsuario" prefWidth="180.0" text="Usuario"/>
                            <TableColumn fx:id="colAudAccion" prefWidth="120.0" text="Acción"/>
                            <TableColumn fx:id="colAudEntidad" prefWidth="140.0" text="Entidad / Ref"/>
                            <TableColumn fx:id="colAudAnterior" prefWidth="110.0" text="Estado Anterior"/>
                            <TableColumn fx:id="colAudNuevo" prefWidth="110.0" text="Estado Nuevo"/>
                            <TableColumn fx:id="colAudDetalles" prefWidth="300.0" text="Detalles Técnicos"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- VISTA 3: GESTIÓN DE USUARIOS Y CUENTAS                     -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <VBox fx:id="paneUsuarios" spacing="16.0" visible="false">
                    <padding>
                        <Insets top="20.0" right="24.0" bottom="24.0" left="24.0"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="3.0">
                            <Label text="👥 Gestión y Directorio de Cuentas del Sistema" styleClass="view-title"/>
                            <Label text="Administración de cuentas de Propietarios, Funcionarios de Alcaldía y Administradores." styleClass="view-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button minWidth="-Infinity" text="➕ Registrar Funcionario" styleClass="btn-action-success" onAction="#onRegistrarFuncionario"/>
                        <Button minWidth="-Infinity" text="🔄 Refrescar Usuarios" styleClass="btn-action-primary" onAction="#cargarDatosUsuarios"/>
                    </HBox>

                    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS" styleClass="admin-table">
                        <columns>
                            <TableColumn fx:id="colUsrId" prefWidth="60.0" text="ID"/>
                            <TableColumn fx:id="colUsrDoc" prefWidth="140.0" text="Cédula / Documento"/>
                            <TableColumn fx:id="colUsrNombre" prefWidth="240.0" text="Nombre Completo"/>
                            <TableColumn fx:id="colUsrRol" prefWidth="150.0" text="Rol Asignado"/>
                            <TableColumn fx:id="colUsrEmail" prefWidth="220.0" text="Correo Electrónico"/>
                            <TableColumn fx:id="colUsrTel" prefWidth="150.0" text="Teléfono"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

            </StackPane>
        </VBox>
    </center>

</BorderPane>
