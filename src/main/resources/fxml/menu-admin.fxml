<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sigcat.controllers.MenuAdminController"
            styleClass="admin-root"
            stylesheets="@../styles/admin-dashboard.css"
            prefWidth="1300.0" prefHeight="820.0">

    <!-- ================================================================= -->
    <!-- SIDEBAR LATERAL (ÍNDIGO / PÚRPURA - ESTILO REFERENCIA)           -->
    <!-- ================================================================= -->
    <left>
        <VBox spacing="14.0" styleClass="admin-sidebar">
            <padding>
                <Insets top="24.0" right="16.0" bottom="20.0" left="16.0"/>
            </padding>

            <!-- AVATAR Y PERFIL DEL ADMINISTRADOR -->
            <VBox alignment="CENTER" spacing="8.0">
                <StackPane>
                    <Circle fx:id="circleAvatar" radius="34.0" styleClass="avatar-circle"/>
                    <Label text="👤" style="-fx-font-size: 30px; -fx-text-fill: #5C6BC0;"/>
                </StackPane>
                <Label fx:id="lblAdminNombre" text="CARLOS PÉREZ" styleClass="admin-name"/>
                <Label fx:id="lblAdminRol" text="ADMINISTRADOR CATASTRAL" styleClass="admin-role"/>
            </VBox>

            <Separator style="-fx-opacity: 0.25;"/>

            <!-- BOTONES DE NAVEGACIÓN -->
            <VBox spacing="6.0">
                <Button maxWidth="1.7976931348623157E308" text="🏠  INICIO / DASHBOARD" styleClass="sidebar-nav-btn, sidebar-nav-btn-active" onAction="#cargarDatosDashboard"/>
                <Button maxWidth="1.7976931348623157E308" text="📋  AUDITORÍA Y TAREAS" styleClass="sidebar-nav-btn" onAction="#cargarDatosDashboard"/>
                <Button maxWidth="1.7976931348623157E308" text="🗺️  MAPA DE SINCELEJO" styleClass="sidebar-nav-btn" onAction="#onVerEnMapa"/>
                <Button maxWidth="1.7976931348623157E308" text="🔄  SINCRONIZAR NUBE" styleClass="sidebar-nav-btn" onAction="#onSincronizarSupabase"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- CERRAR SESIÓN -->
            <Button maxWidth="1.7976931348623157E308" text="🚪  Cerrar Sesión" styleClass="sidebar-logout-btn" onAction="#cerrarSesion"/>
        </VBox>
    </left>

    <!-- ================================================================= -->
    <!-- ÁREA CENTRAL DE CONTENIDO                                         -->
    <!-- ================================================================= -->
    <center>
        <VBox spacing="0.0">

            <!-- BARRA SUPERIOR DE BÚSQUEDA Y ESTADO -->
            <HBox spacing="16.0" styleClass="admin-topbar">
                <Label text="SIGCAT — Panel de Administración Catastral (Sincelejo, Sucre)" styleClass="topbar-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtBuscar" promptText="🔍 Buscar por código, predio o propietario..." styleClass="search-box"/>
                <Label fx:id="lblSyncStatus" text="🟢 Supabase En Línea" styleClass="sync-badge-online"/>
            </HBox>

            <!-- CONTENIDO CON SCROLL -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox spacing="18.0">
                    <padding>
                        <Insets top="18.0" right="22.0" bottom="22.0" left="22.0"/>
                    </padding>

                    <!-- ─── 1. FILA DE TARJETAS KPI GRADIENTES ─── -->
                    <HBox spacing="18.0">
                        <!-- KPI 1: TURQUESA -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-gradient-green" spacing="4.0">
                            <Label text="TOTAL PREDIOS EN MALLA" styleClass="kpi-label"/>
                            <Label fx:id="lblTotalPredios" text="14 Predios" styleClass="kpi-value"/>
                            <Label fx:id="lblAreaTotal" text="Área total: 38,450.00 m²" styleClass="kpi-subtext"/>
                        </VBox>

                        <!-- KPI 2: AZUL / PERIWINKLE -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-gradient-blue" spacing="4.0">
                            <Label text="SOLICITUDES AUDITADAS" styleClass="kpi-label"/>
                            <Label fx:id="lblSolicitudesAuditadas" text="8 Auditadas" styleClass="kpi-value"/>
                            <Label fx:id="lblResumenAuditadas" text="Pendientes en cola de revisión" styleClass="kpi-subtext"/>
                        </VBox>

                        <!-- KPI 3: PÚRPURA -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-gradient-purple" spacing="4.0">
                            <Label text="TASA DE CONFORMIDAD TOPOLÓGICA" styleClass="kpi-label"/>
                            <Label fx:id="lblTasaAprobacion" text="88%" styleClass="kpi-value"/>
                            <Label fx:id="lblResumenNorma" text="Sin colisiones catastrales" styleClass="kpi-subtext"/>
                        </VBox>
                    </HBox>

                    <!-- ─── 2. FILA INTERMEDIA: TABLA DE TAREAS + GRÁFICO DE TENDENCIA ─── -->
                    <HBox spacing="18.0" prefHeight="330.0">
                        <!-- COLUMNA IZQUIERDA: BANDEJA DE AUDITORÍA -->
                        <VBox prefWidth="580.0" styleClass="content-card" spacing="12.0">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="SOLICITUDES &amp; CONTROL TERRITORIAL" styleClass="card-header-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="AUDITORÍA" styleClass="pill-header-purple"/>
                            </HBox>

                            <TableView fx:id="tablaSolicitudes" VBox.vgrow="ALWAYS" styleClass="admin-table">
                                <columns>
                                    <TableColumn fx:id="colCodigo" prefWidth="105.0" text="Código"/>
                                    <TableColumn fx:id="colNombre" prefWidth="130.0" text="Predio"/>
                                    <TableColumn fx:id="colPropietario" prefWidth="125.0" text="Propietario"/>
                                    <TableColumn fx:id="colArea" prefWidth="85.0" text="Área"/>
                                    <TableColumn fx:id="colEstado" prefWidth="85.0" text="Estado"/>
                                    <TableColumn fx:id="colSoporte" prefWidth="90.0" text="Soporte"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>

                            <!-- BOTONES DE ACCIÓN RÁPIDA -->
                            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                                <Button text="✔ Aprobar" styleClass="btn-action-success" onAction="#onAprobarSeleccionado"/>
                                <Button text="✖ Rechazar" styleClass="btn-action-danger" onAction="#onRechazarSeleccionado"/>
                                <Button text="🗺️ Ver en Mapa" styleClass="btn-action-primary" onAction="#onVerEnMapa"/>
                            </HBox>
                        </VBox>

                        <!-- COLUMNA DERECHA: GRÁFICO DE TENDENCIA (AREACHART) -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="content-card" spacing="8.0">
                            <Label text="RADICACIONES MENSUALES Y TENDENCIA CATASTRAL (SINCELEJO)" styleClass="card-header-label"/>
                            <AreaChart fx:id="chartTendencia" VBox.vgrow="ALWAYS" legendSide="TOP" createSymbols="true">
                                <xAxis>
                                    <CategoryAxis label="Meses"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Trámites"/>
                                </yAxis>
                            </AreaChart>
                        </VBox>
                    </HBox>

                    <!-- ─── 3. FILA INFERIOR: COBERTURA POR SECTORES Y DONUT ─── -->
                    <HBox spacing="18.0" prefHeight="170.0">
                        <!-- SECTOR PROGRESS BARS -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="content-card" spacing="10.0">
                            <Label text="COBERTURA DE INCORPORACIÓN POR SECTORES" styleClass="card-header-label"/>
                            
                            <VBox spacing="6.0">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Centro Histórico (Sincelejo):" style="-fx-font-weight: 600; -fx-text-fill: #334155;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="75%" style="-fx-text-fill: #10B981; -fx-font-weight: bold;"/>
                                </HBox>
                                <ProgressBar fx:id="progressCentro" progress="0.75" maxWidth="1.7976931348623157E308" styleClass="progress-bar, bar-verde"/>

                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Sector Norte (Universidad / Puerta Roja):" style="-fx-font-weight: 600; -fx-text-fill: #334155;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="60%" style="-fx-text-fill: #F97316; -fx-font-weight: bold;"/>
                                </HBox>
                                <ProgressBar fx:id="progressNorte" progress="0.60" maxWidth="1.7976931348623157E308" styleClass="progress-bar, bar-naranja"/>

                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Sector Majagual / San Carlos:" style="-fx-font-weight: 600; -fx-text-fill: #334155;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="80%" style="-fx-text-fill: #8B5CF6; -fx-font-weight: bold;"/>
                                </HBox>
                                <ProgressBar fx:id="progressMajagual" progress="0.80" maxWidth="1.7976931348623157E308" styleClass="progress-bar, bar-morado"/>
                            </VBox>
                        </VBox>

                        <!-- DONUT CIRCLE INDICATOR (IGUAL A LA IMAGEN) -->
                        <VBox prefWidth="250.0" alignment="CENTER" styleClass="content-card" spacing="6.0">
                            <Label text="CUMPLIMIENTO NORMATIVO" styleClass="card-header-label"/>
                            <StackPane prefHeight="105.0" prefWidth="105.0">
                                <Circle radius="42.0" styleClass="donut-circle-bg"/>
                                <Circle radius="42.0" styleClass="donut-circle-value" strokeDashArray="190, 70"/>
                                <VBox alignment="CENTER">
                                    <Label fx:id="lblDonutPercent" text="88%" styleClass="donut-percentage-text"/>
                                    <Label text="APROBADO" styleClass="donut-subtext"/>
                                </VBox>
                            </StackPane>
                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>

