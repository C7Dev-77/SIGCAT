<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- =========================================================== -->
    <!--   INFORMACIÓN DEL PROYECTO                                    -->
    <!-- =========================================================== -->
    <groupId>com.sigcat</groupId>
    <artifactId>SIGCAT</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>SIGCAT</name>
    <description>
        Sistema de Registro Gráfico de Predios y Detección Automática de
        Solapamiento Catastral - UNIAJS / Ingeniería de Software
    </description>

    <!-- =========================================================== -->
    <!--   PROPIEDADES GLOBALES                                        -->
    <!-- =========================================================== -->
    <properties>
        <!-- Compilación con Java 17 LTS -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versiones de dependencias -->
        <javafx.version>21</javafx.version>
        <sqlite.version>3.53.4.0</sqlite.version>
        <jts.version>1.20.0</jts.version>
        <junit.version>5.11.0</junit.version>

        <!-- Clase principal -->
        <main.class>com.sigcat.app.MainLauncher</main.class>
    </properties>

    <!-- =========================================================== -->
    <!--   DEPENDENCIAS                                                -->
    <!-- =========================================================== -->
    <dependencies>

        <!-- ─── JavaFX 21 LTS ─── -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- ─── SQLite JDBC (base de datos embebida) ─── -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- ─── JTS Topology Suite (detección de solapamientos) ─── -->
        <dependency>
            <groupId>org.locationtech.jts</groupId>
            <artifactId>jts-core</artifactId>
            <version>${jts.version}</version>
        </dependency>

        <!-- ─── JUnit Jupiter (pruebas unitarias) ─── -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ─── BCrypt para hash seguro de contraseñas (RNF-01) ─── -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

    </dependencies>

    <!-- =========================================================== -->
    <!--   BUILD Y PLUGINS                                             -->
    <!-- =========================================================== -->
    <build>
        <plugins>

            <!-- Plugin de compilación de Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Plugin de JavaFX para ejecutar en desarrollo -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.sigcat.app.App</mainClass>
                </configuration>
            </plugin>

            <!-- Plugin de pruebas con JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <!-- Las pruebas automatizadas usan una base de datos de test aislada para no contaminar sigcat.db -->
                    <systemPropertyVariables>
                        <sigcat.db>target/sigcat_test.db</sigcat.db>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
                Maven Shade Plugin: genera el Fat JAR ejecutable (Fase 4)
                Responsable: Cristian Morales (Arquitecto)

                Transformers aplicados:
                  1. ManifestResourceTransformer → escribe el Main-Class en MANIFEST.MF
                     apuntando a MainLauncher (no extiende Application, evita el error
                     "JavaFX runtime components are missing" al ejecutar con java -jar).
                  2. ServicesResourceTransformer → fusiona los archivos de ServiceLoader
                     (META-INF/services/*) de todos los JARs en uno solo.
                     CRÍTICO para SQLite JDBC (org.sqlite.JDBC) y JTS: sin este transformer,
                     Class.forName() o DriverManager.getConnection() lanzan
                     "No suitable driver found" dentro del fat JAR.

                Filtros aplicados:
                  - Se excluyen ficheros de firma (.SF, .DSA, .RSA) que causan
                    SecurityException al mezclar JARs firmados en un único artefacto.
                  - Se excluyen los module-info.class para evitar conflictos de módulos
                    al correr en classpath (modo sin módulos).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>fat-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- No genera dependency-reduced-pom.xml: mantiene target/ limpio -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!-- El fat JAR se llama SIGCAT-1.0-SNAPSHOT-fat.jar -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>fat</shadedClassifierName>

                            <transformers>
                                <!-- 1. Escribe Main-Class en MANIFEST.MF -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <Implementation-Title>SIGCAT</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>

                                <!-- 2. Fusiona META-INF/services/* de todos los JARs -->
                                <!--    Sin esto, SQLite JDBC no encuentra el driver    -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>

                            <!-- Filtros para evitar conflictos al fusionar JARs -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Firmas digitales de JARs individuales (causan SecurityException) -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- module-info.class: evita conflictos en classpath sin módulos -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
